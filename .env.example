# Copy to .env (git-ignored). Used by make dev / run / cli. Plain KEY=value, no quotes.

# Created on the first start. 12+ characters.
GLUCAVA_ADMIN_EMAIL=you@example.com
GLUCAVA_ADMIN_PASSWORD=change-me-to-a-long-password

# Optional: seed Dexcom Share credentials on first start, instead of running
# `make dexcom`. Only used once, while no Dexcom credential is stored yet;
# safe to remove from .env after the first run.
# GLUCAVA_DEXCOM_USERNAME=you@example.com
# GLUCAVA_DEXCOM_PASSWORD=your-dexcom-share-password
# GLUCAVA_DEXCOM_REGION=ous

# Optional: readings/events retention, in days (0 keeps them forever). This
# always overrides the UI setting on every start, not just the first one;
# remove it from .env to let the UI value stick again.
# GLUCAVA_RETENTION_DAYS=365

# Optional: email notifications. These only SEED the settings on first start
# (while no SMTP host is saved yet); afterwards edit them in Settings -> Email.
# Host and sender address are required; TO is the recipient. The password may
# be added later: it is stored once if none is stored yet.
#
# Gmail example (needs 2-Step Verification; create a 16-character app password at
# https://myaccount.google.com/apppasswords - your normal password will NOT work;
# type it without spaces). The sender must be the Gmail address itself.
# GLUCAVA_SMTP_HOST=smtp.gmail.com
# GLUCAVA_SMTP_PORT=587
# GLUCAVA_SMTP_TLS=0
# GLUCAVA_SMTP_USERNAME=you@gmail.com
# GLUCAVA_SMTP_PASSWORD=your-16-char-app-password
# GLUCAVA_SMTP_SENDER_ADDRESS=you@gmail.com
# GLUCAVA_SMTP_SENDER_NAME=glucava
# GLUCAVA_SMTP_TO=you@gmail.com
# (Port 465 instead of 587: also set GLUCAVA_SMTP_TLS=1.)

# Optional: the address you open the web UI at. Used for "Open in glucava"
# links in emails; without it mails carry no such links. Seeds the setting
# only while none is saved. The mail kinds (failure alerts on; per-activity
# and weekly summaries off) are switched in Settings -> Email, or with
# `glucava config set mail_weekly true`.
# GLUCAVA_PUBLIC_URL=https://glucava.example.com

# Optional tuning (defaults shown). A bad value stops the server at start.
# GLUCAVA_SOURCE=dexcom
# GLUCAVA_CANARY_INTERVAL=24h          # or "off"
# GLUCAVA_POLL_LOOKBACK=24h
# GLUCAVA_RETRY_BACKOFF=1m,3m,10m
# GLUCAVA_NOTIFY_COOLDOWN=6h
# GLUCAVA_NOTIFY_MAX_AGE=24h
# If Strava changes its edit page, add selectors here (tried before the built-in
# ones), then verify with `glucava strava check`:
# GLUCAVA_STRAVA_SELECTOR_DESCRIPTION=["textarea.some-new-class"]
# GLUCAVA_STRAVA_SELECTOR_SAVE=["button.save"]

# Chrome/Chromium for the Strava writer, if it is not on PATH.
# CHROME_PATH=/usr/bin/chromium

# Optional: keep the key out of the data dir (openssl rand -base64 32).
# GLUCAVA_SECRET_KEY=

# Optional: your reverse proxy, so rate limits see the real client.
# GLUCAVA_TRUSTED_PROXIES=127.0.0.1

# Optional: another port (default 8090).
# PORT=8090
